<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MIND — 균열</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;700;900&display=swap');
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#07070f; --panel:#0d0d1c; --border:#18183a;
  --acc:#7c6fe0; --acc2:#e07ca0; --text:#cccaf0; --dim:#3d3b60;
}
body{background:var(--bg);color:var(--text);font-family:'Noto Sans KR',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;overflow-x:hidden;}

/* ── SCREEN SYSTEM ── */
.screen{display:none;width:100%;max-width:700px;padding:28px 18px;flex-direction:column;align-items:center;}
.screen.active{display:flex;}

/* ── TITLE ── */
#s-title{justify-content:center;min-height:100vh;text-align:center;gap:22px;}
.logo{font-size:5rem;font-weight:900;letter-spacing:14px;background:linear-gradient(135deg,#7c6fe0,#b16cea,#6ee7f7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.logo-sub{font-size:1rem;color:var(--dim);letter-spacing:6px;text-transform:uppercase;}
.intro-box{max-width:440px;font-size:.9rem;color:#7a789a;line-height:2;border-left:2px solid var(--acc);padding-left:16px;text-align:left;}
.btn-p{padding:14px 44px;border:none;border-radius:14px;background:linear-gradient(135deg,#7c6fe0,#b16cea);color:#fff;font-size:16px;font-weight:700;cursor:pointer;font-family:'Noto Sans KR',sans-serif;transition:all .2s;box-shadow:0 4px 28px rgba(124,111,224,.3);}
.btn-p:hover{transform:translateY(-3px);box-shadow:0 8px 36px rgba(124,111,224,.5);}
.btn-ghost{padding:10px 28px;border:1px solid var(--border);border-radius:12px;background:transparent;color:var(--dim);font-size:.85rem;font-weight:700;cursor:pointer;font-family:'Noto Sans KR',sans-serif;transition:all .2s;}
.btn-ghost:hover{border-color:var(--acc);color:var(--text);}

/* ── DIALOG ── */
#s-dialog{gap:0;min-height:100vh;justify-content:flex-end;padding-bottom:28px;}
#d-bg{position:fixed;inset:0;z-index:0;transition:background 1.2s;}
#d-scene{position:fixed;inset:0;z-index:1;display:flex;align-items:center;justify-content:center;pointer-events:none;}
#scene-art{font-size:8rem;opacity:.3;transition:all 1.2s;filter:blur(1px);}
#d-badge{position:fixed;top:18px;left:50%;transform:translateX(-50%);background:rgba(124,111,224,.12);border:1px solid var(--acc);border-radius:20px;padding:5px 18px;font-size:.72rem;color:var(--acc);font-weight:700;letter-spacing:1px;z-index:5;}
#d-sanity{position:fixed;top:18px;right:18px;z-index:5;display:flex;flex-direction:column;align-items:flex-end;gap:4px;}
#d-sanity .sl{font-size:.65rem;color:var(--dim);letter-spacing:1px;text-transform:uppercase;}
#sanity-bar-wrap{width:100px;height:5px;background:var(--border);border-radius:99px;overflow:hidden;}
#sanity-bar{height:100%;background:var(--acc);border-radius:99px;transition:width .6s ease,background .6s;}
#d-box{position:relative;z-index:2;width:100%;max-width:660px;background:rgba(13,13,28,.94);border:1px solid var(--border);border-radius:18px;padding:22px 26px;backdrop-filter:blur(14px);box-shadow:0 0 60px rgba(124,111,224,.12);}
#d-speaker{font-size:.72rem;font-weight:700;color:var(--acc);letter-spacing:2px;text-transform:uppercase;margin-bottom:8px;}
#d-text{font-size:.97rem;line-height:1.85;min-height:56px;}
#d-cursor{display:inline-block;animation:blink .75s infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
#d-next{margin-top:14px;width:100%;padding:11px;background:transparent;border:1px solid var(--border);border-radius:10px;color:var(--dim);font-size:.78rem;cursor:pointer;font-family:'Noto Sans KR',sans-serif;transition:all .2s;}
#d-next:hover{border-color:var(--acc);color:var(--text);}
/* glitch effect on text */
.glitch{animation:glitchText .15s infinite;}
@keyframes glitchText{0%{text-shadow:2px 0 #e07ca0,-2px 0 #7c6fe0}50%{text-shadow:-2px 0 #e07ca0,2px 0 #7c6fe0}100%{text-shadow:2px 0 #7c6fe0,-2px 0 #e07ca0}}
.crack{color:#e07ca0 !important;font-weight:700;}

/* ── PUZZLE ── */
#s-puzzle{gap:14px;min-height:100vh;padding-top:20px;}
#pz-hd{text-align:center;}
#pz-ch{font-size:.72rem;color:var(--acc);letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;}
#pz-title{font-size:1.3rem;font-weight:700;}
#pz-desc{font-size:.8rem;color:var(--dim);margin-top:5px;line-height:1.6;max-width:500px;text-align:center;}
#timer-wrap{width:100%;height:4px;background:var(--border);border-radius:99px;overflow:hidden;}
#timer-bar{height:100%;background:var(--acc);border-radius:99px;transition:width .1s linear,background .3s;}
#pz-area{background:var(--panel);border:1px solid var(--border);border-radius:18px;padding:20px;width:100%;display:flex;flex-direction:column;align-items:center;gap:18px;}
#pz-vis{width:100%;display:flex;justify-content:center;align-items:center;min-height:240px;flex-wrap:wrap;gap:12px;}
canvas.pcv{border-radius:10px;border:1px solid var(--border);cursor:default;max-width:100%;}
#pz-q{font-size:.95rem;font-weight:700;text-align:center;color:var(--text);}
#pz-btns{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;}
.cb{padding:11px 22px;border:1px solid var(--border);border-radius:10px;background:var(--bg);color:var(--text);font-size:.88rem;font-weight:700;cursor:pointer;transition:all .2s;font-family:'Noto Sans KR',sans-serif;}
.cb:hover{border-color:var(--acc);background:rgba(124,111,224,.1);}
.cb.ok2{border-color:#34d399;background:rgba(52,211,153,.12);color:#34d399;}
.cb.ng{border-color:#f87171;background:rgba(248,113,113,.08);color:#f87171;}
#pz-fb{font-size:.88rem;font-weight:700;min-height:22px;text-align:center;transition:color .3s;line-height:1.6;max-width:480px;}
#pz-fb.ok{color:#34d399;}#pz-fb.no{color:#f87171;}
#hint-btn{font-size:.72rem;color:var(--dim);background:none;border:none;cursor:pointer;text-decoration:underline;font-family:'Noto Sans KR',sans-serif;}
#hint-btn:hover{color:var(--text);}
#hint-txt{font-size:.8rem;color:#9d8fe0;display:none;text-align:center;line-height:1.7;max-width:440px;}

/* ── CRACK OVERLAY ── */
#crack-overlay{display:none;position:fixed;inset:0;z-index:50;pointer-events:none;background:transparent;}
#crack-overlay.show{display:block;}
#crack-overlay canvas{position:absolute;inset:0;width:100%;height:100%;}

/* ── CHOICE SCREEN ── */
#s-choice{justify-content:center;min-height:100vh;gap:20px;text-align:center;}
#s-choice h2{font-size:1.6rem;font-weight:900;}
#s-choice p{color:var(--dim);font-size:.85rem;max-width:400px;line-height:1.8;}
#s-choice .choices-wrap{display:flex;flex-direction:column;gap:12px;width:100%;max-width:440px;}
.choice-card{padding:18px 22px;border:1px solid var(--border);border-radius:14px;background:var(--panel);cursor:pointer;transition:all .2s;text-align:left;}
.choice-card:hover{border-color:var(--acc);transform:translateX(4px);}
.choice-card .ct{font-size:.95rem;font-weight:700;margin-bottom:4px;}
.choice-card .cd{font-size:.78rem;color:var(--dim);line-height:1.6;}

/* ── ENDING SCREENS ── */
#s-end{justify-content:center;min-height:100vh;gap:22px;text-align:center;padding-top:40px;}
.end-art{font-size:5rem;}
.end-title{font-size:2rem;font-weight:900;line-height:1.3;}
.end-body{font-size:.9rem;color:#8885b0;line-height:1.9;max-width:440px;border-left:2px solid var(--acc2);padding-left:16px;text-align:left;}
.end-tag{font-size:.7rem;color:var(--dim);letter-spacing:2px;text-transform:uppercase;}
</style>
</head>
<body>

<!-- TITLE -->
<div id="s-title" class="screen active">
  <div class="logo">MIND</div>
  <div class="logo-sub">균 열</div>
  <div class="intro-box">
    당신은 유능한 심리치료사입니다.<br>
    수많은 환자들의 마음을 고쳐왔죠.<br><br>
    그러나 오늘, 마지막 환자가<br>
    당신에게 묻습니다.<br><br>
    <span style="color:#a09ab8"><i>"선생님, 선생님은 괜찮으세요?"</i></span>
  </div>
  <button class="btn-p" onclick="startGame()">▶ 시작하기</button>
</div>

<!-- DIALOG -->
<div id="s-dialog" class="screen">
  <div id="d-bg"></div>
  <div id="d-scene"><div id="scene-art">🏥</div></div>
  <div id="d-badge">PROLOGUE</div>
  <div id="d-sanity"><div class="sl">정신력</div><div id="sanity-bar-wrap"><div id="sanity-bar" style="width:100%"></div></div></div>
  <div id="d-box">
    <div id="d-speaker">???</div>
    <div id="d-text"><span id="d-text-in"></span><span id="d-cursor">▍</span></div>
    <button id="d-next" onclick="nextDialog()">계속 ▶</button>
  </div>
</div>

<!-- PUZZLE -->
<div id="s-puzzle" class="screen">
  <div id="pz-hd">
    <div id="pz-ch">CASE 1</div>
    <div id="pz-title">착시의 이름</div>
    <div id="pz-desc"></div>
  </div>
  <div id="timer-wrap"><div id="timer-bar" style="width:100%"></div></div>
  <div id="pz-area">
    <div id="pz-vis"></div>
