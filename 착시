    <div id="pz-btns"></div>
    <div id="pz-fb"></div>
    <button id="hint-btn" onclick="toggleHint()">💡 힌트</button>
    <div id="hint-txt"></div>
  </div>
</div>

<!-- CRITICAL CHOICE -->
<div id="s-choice" class="screen">
  <h2 id="choice-title">선택의 순간</h2>
  <p id="choice-desc"></p>
  <div class="choices-wrap" id="choices-wrap"></div>
</div>

<!-- ENDING -->
<div id="s-end" class="screen">
  <div class="end-art" id="end-art">🧠</div>
  <div class="end-tag" id="end-tag">ENDING A</div>
  <div class="end-title" id="end-title">제목</div>
  <div class="end-body" id="end-body">내용</div>
  <button class="btn-p" style="margin-top:8px" onclick="startGame()">🔄 다시 하기</button>
  <button class="btn-ghost" onclick="showTitleScreen()">◀ 처음으로</button>
</div>

<!-- CRACK OVERLAY -->
<div id="crack-overlay"><canvas id="crack-cv"></canvas></div>

<script>
// ================================================================
//  STATE
// ================================================================
let sanity = 100;      // 0~100
let chIdx = 0;         // current chapter index
let dIdx = 0;          // dialog line index
let dMode = 'pre';     // 'pre' | 'post'
let puzzleOk = false;
let wrongCount = 0;    // total wrong answers across all puzzles
let timerInt = null;
let timeLeft = 0;
let typing = false, typeInt = null, fullText = '';
let charPos = 0;
let crackAnim = null;

// Final choice accumulator
let choiceMade = null; // 'accept' | 'deny' | 'collapse'

// ================================================================
//  SANITY SYSTEM
// ================================================================
function setSanity(v) {
  sanity = Math.max(0, Math.min(100, v));
  const bar = document.getElementById('sanity-bar');
  bar.style.width = sanity + '%';
  bar.style.background = sanity > 60 ? '#7c6fe0' : sanity > 30 ? '#fbbf24' : '#f87171';
  if (sanity <= 30) flashCrack();
}

function loseSanity(n) { setSanity(sanity - n); }

// ================================================================
//  CRACK OVERLAY
// ================================================================
function flashCrack() {
  const ov = document.getElementById('crack-overlay');
  const cv2 = document.getElementById('crack-cv');
  cv2.width = window.innerWidth; cv2.height = window.innerHeight;
  const ctx2 = cv2.getContext('2d');
  ctx2.clearRect(0,0,cv2.width,cv2.height);
  const n = 6 + Math.floor((100-sanity)/15);
  for (let i=0;i<n;i++) {
    ctx2.strokeStyle = `rgba(224,124,160,${0.15+Math.random()*0.25})`;
    ctx2.lineWidth = 1 + Math.random()*2;
    ctx2.beginPath();
    let x=Math.random()*cv2.width, y=Math.random()*cv2.height;
    ctx2.moveTo(x,y);
    for(let j=0;j<5;j++){x+=(-60+Math.random()*120);y+=(-60+Math.random()*120);ctx2.lineTo(x,y);}
    ctx2.stroke();
  }
  ov.classList.add('show');
  clearTimeout(crackAnim);
  crackAnim = setTimeout(()=>ov.classList.remove('show'), 600);
}

