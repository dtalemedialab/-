    const col='rgb(148,142,200)';
    c.fillStyle=col;c.beginPath();c.arc(105,100,48,0,Math.PI*2);c.fill();
    c.fillStyle=col;c.beginPath();c.arc(315,100,48,0,Math.PI*2);c.fill();
