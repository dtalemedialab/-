function startPuzzle(){
  const pz=STORY[chIdx].puzzle;
  puzzleOk=false;
  document.getElementById('pz-ch').textContent=STORY[chIdx].badge+' · 착시 검사';
  document.getElementById('pz-title').textContent=pz.title;
  document.getElementById('pz-desc').textContent=pz.desc;
