// ================================================================
function show(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0,0);
}
function showTitleScreen(){ show('s-title'); }

// ================================================================
//  DIALOG ENGINE
// ================================================================
function typeText(txt){
  fullText=txt; charPos=0; typing=true;
  document.getElementById('d-text-in').textContent='';
  clearInterval(typeInt);
  typeInt=setInterval(()=>{
    document.getElementById('d-text-in').textContent=fullText.slice(0,++charPos);
    if(charPos>=fullText.length){clearInterval(typeInt);typing=false;}
  },24);
}

function nextDialog(){
  if(typing){clearInterval(typeInt);document.getElementById('d-text-in').textContent=fullText;typing=false;return;}
  dIdx++;
  renderDialog();
}

function renderDialog(){
  const ch=STORY[chIdx];
  const lines=dMode==='pre'?ch.pre:ch.post;
  if(dIdx>=lines.length){
    if(dMode==='pre'){
      startPuzzle();
    } else {
      // advance
      chIdx++;
      if(chIdx>=STORY.length){
        // should not reach here normally
        return;
      }
      const next=STORY[chIdx];
      beginChapter();
    }
    return;
  }
  const line=lines[dIdx];
  document.getElementById('d-speaker').textContent=line.sp;
  typeText(line.tx);
  // Apply glitch at low sanity
  if(sanity<40){
    document.getElementById('d-text-in').classList.add('glitch');
  } else {
    document.getElementById('d-text-in').classList.remove('glitch');
  }
}

function beginChapter(){
  const ch=STORY[chIdx];
  dIdx=0; dMode='pre';
  document.getElementById('d-badge').textContent=ch.badge;
  document.getElementById('d-bg').style.background=ch.bg;
  document.getElementById('scene-art').textContent=ch.art;
  if(ch.sanityHit) loseSanity(ch.sanityHit);
  show('s-dialog');
  renderDialog();
}

