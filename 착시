function drawEbbinghaus(c,cx,cy,inner,outer,color){
  const n=6;
  for(let i=0;i<n;i++){
    const a=i/n*Math.PI*2;
    const d=inner+outer+10;
    c.beginPath();c.arc(cx+Math.cos(a)*d,cy+Math.sin(a)*d,outer,0,Math.PI*2);
    c.strokeStyle=color;c.lineWidth=2;c.stroke();
    c.fillStyle='rgba(124,111,224,0.08)';c.fill();
  }
  c.beginPath();c.arc(cx,cy,inner,0,Math.PI*2);
  c.fillStyle=color;c.fill();
}

function drawRotation(c,cx,cy,r){
  for(let ring=0;ring<4;ring++){
    const rr=(ring+1)*r/4;
    const n=14+ring*8;
    for(let i=0;i<n;i++){
      const a=i/n*Math.PI*2;
      const off=(ring%2===0?1:-1)*0.25;
      const px=cx+Math.cos(a+off)*rr, py=cy+Math.sin(a+off)*rr;
      c.save();c.translate(px,py);c.rotate(a+(ring%2===0?Math.PI/4:-Math.PI/4));
      c.fillStyle=i%2===0?'#1e1e38':'#a78bfa';
      c.fillRect(-10,-5,20,10);c.restore();
    }
  }
}

function drawRubinVase(c,cx,cy,h){
  c.fillStyle='#e8e4ff';
  // vase shape (white)
  c.beginPath();
  c.moveTo(cx,cy-h);
  c.bezierCurveTo(cx+40,cy-h+40,cx+60,cy-40,cx+50,cy+h);
  c.lineTo(cx-50,cy+h);
  c.bezierCurveTo(cx-60,cy-40,cx-40,cy-h+40,cx,cy-h);
  c.fill();
  // faces (black) — fill the whole canvas then cut out vase
  c.fillStyle='#0d0d1a';
  c.fillRect(cx-90,cy-h-10,90,h*2+20);
  c.fillRect(cx,cy-h-10,90,h*2+20);
  c.fillStyle='#e8e4ff';
  c.beginPath();
  c.moveTo(cx,cy-h);
  c.bezierCurveTo(cx+40,cy-h+40,cx+60,cy-40,cx+50,cy+h);
  c.lineTo(cx-50,cy+h);
  c.bezierCurveTo(cx-60,cy-40,cx-40,cy-h+40,cx,cy-h);
  c.fill();
}

function drawPonzo(c,cx,H){
  c.strokeStyle='#2d2d50';c.lineWidth=2;
  c.beginPath();c.moveTo(cx-80,H-20);c.lineTo(cx,H*0.12);c.stroke();
  c.beginPath();c.moveTo(cx+80,H-20);c.lineTo(cx,H*0.12);c.stroke();
  // equal horizontal lines
  c.strokeStyle='#a78bfa';c.lineWidth=4;
  c.beginPath();c.moveTo(cx-55,H*0.65);c.lineTo(cx+55,H*0.65);c.stroke();
  c.beginPath();c.moveTo(cx-55,H*0.3);c.lineTo(cx+55,H*0.3);c.stroke();
  c.fillStyle='#6b7280';c.font='bold 13px sans-serif';c.textAlign='right';
  c.fillText('B',cx-58,H*0.65+5);
  c.fillText('A',cx-58,H*0.3+5);
}

function drawCafeWall(c,W,H){
  const rows=7,sz=26;
  for(let r=0;r<rows;r++){
    const off=(r%2)*(sz/2);
    const cols=Math.ceil((W+sz)/sz);
    for(let col=0;col<cols;col++){
      const x=off+col*sz-sz/2, y=r*sz+10;
      c.fillStyle=(r+col)%2===0?'#d4d0f0':'#18183a';
      c.fillRect(x,y,sz,sz);
    }
    c.fillStyle='#5a5870';c.fillRect(0,r*sz+10-1,W,2);
  }
}

function renderPuzzleBtns(pz){
  const wrap=document.getElementById('pz-btns');
  wrap.innerHTML='';
  pz.choices.forEach(ch2=>{
    const b=document.createElement('button');
    b.className='cb';b.textContent=ch2;
    b.addEventListener('click',()=>answerPuzzle(ch2,b));
    wrap.appendChild(b);
  });
}

function answerPuzzle(choice,btn){
  if(puzzleOk)return;
  puzzleOk=true;
  clearInterval(timerInt);
  const pz=STORY[chIdx].puzzle;
  const ok=choice===pz.correct;
  const fb=document.getElementById('pz-fb');
  if(ok){
    btn.classList.add('ok2');
    fb.textContent='✅ '+pz.okTx;fb.className='ok';
  } else {
    btn.classList.add('ng');
    fb.textContent='❌ '+pz.ngTx;fb.className='no';
    loseSanity(8);wrongCount++;
    document.querySelectorAll('.cb').forEach(b=>{if(b.textContent===pz.correct)b.classList.add('ok2');});
  }
  document.querySelectorAll('.cb').forEach(b=>b.disabled=true);

  const ch=STORY[chIdx];
  if(ch.isChoice){
    setTimeout(()=>showChoiceScreen(ch),2000);
  } else {
    setTimeout(()=>{dIdx=0;dMode='post';show('s-dialog');renderDialog();},2000);
  }
}

function toggleHint(){
  const h=document.getElementById('hint-txt');
  h.style.display=h.style.display==='none'?'block':'none';
  loseSanity(3);
}

// ================================================================
//  TIMER
// ================================================================
function startTimer(sec){
  timeLeft=sec;
  const bar=document.getElementById('timer-bar');
  bar.style.width='100%';
  bar.style.background='var(--acc)';
  clearInterval(timerInt);
  timerInt=setInterval(()=>{
    timeLeft-=.1;
    const pct=Math.max(0,timeLeft/sec*100);
    bar.style.width=pct+'%';
    if(pct<30)bar.style.background='#f87171';
    else if(pct<60)bar.style.background='#fbbf24';
    if(timeLeft<=0){clearInterval(timerInt);if(!puzzleOk)timeUp();}
  },100);
}

function timeUp(){
  puzzleOk=true;
  const pz=STORY[chIdx].puzzle;
  const fb=document.getElementById('pz-fb');
  fb.textContent='⏰ '+pz.ngTx;fb.className='no';
  loseSanity(12);wrongCount++;
  document.querySelectorAll('.cb').forEach(b=>{b.disabled=true;if(b.textContent===pz.correct)b.classList.add('ok2');});
  const ch=STORY[chIdx];
  if(ch.isChoice){setTimeout(()=>showChoiceScreen(ch),2000);}
  else{setTimeout(()=>{dIdx=0;dMode='post';show('s-dialog');renderDialog();},2000);}
}

// ================================================================
//  CHOICE SCREEN
// ================================================================
function showChoiceScreen(ch){
  document.getElementById('choice-title').textContent=ch.choiceTitle;
  document.getElementById('choice-desc').textContent=ch.choiceDesc;
  const wrap=document.getElementById('choices-wrap');
  wrap.innerHTML='';
  ch.choices.forEach(opt=>{
    const card=document.createElement('div');
    card.className='choice-card';
    card.innerHTML='<div class="ct">'+opt.label+'</div><div class="cd">'+opt.desc+'</div>';
    card.addEventListener('click',()=>{
      choiceMade=opt.key;
      // play post dialogs first (if any) then show ending
      dIdx=0;dMode='post';show('s-dialog');renderDialog();
    });
    wrap.appendChild(card);
  });
  show('s-choice');
}

// ================================================================
//  CHAPTER ADVANCE — override renderDialog's auto-advance
// ================================================================
const _origRenderDialog = renderDialog;
// Patch post-dialog advance for final chapter
function renderDialog(){
  const ch=STORY[chIdx];
  const lines=dMode==='pre'?ch.pre:ch.post;
  if(dIdx>=lines.length){
    if(dMode==='pre'){
      startPuzzle();
    } else {
      // if this was the choice chapter's post, show ending
      if(ch.isChoice && choiceMade){
        showEnding(choiceMade);
        return;
      }
      chIdx++;
      if(chIdx>=STORY.length){showEnding('deny');return;}
      beginChapter();
    }
    return;
  }
  const line=lines[dIdx];
  document.getElementById('d-speaker').textContent=line.sp;
  typeText(line.tx);
  if(sanity<35){
    document.getElementById('d-text-in').classList.add('glitch');
  } else {
    document.getElementById('d-text-in').classList.remove('glitch');
  }
}

// ================================================================
//  ENDINGS
// ================================================================
function showEnding(key){
  const e=ENDINGS[key]||ENDINGS.deny;
  document.getElementById('end-tag').textContent=e.tag;
  document.getElementById('end-art').textContent=e.art;
  document.getElementById('end-title').textContent=e.title;
  document.getElementById('end-body').style.borderColor=e.color;
  // format line breaks
  document.getElementById('end-body').innerHTML=e.body.replace(/\n/g,'<br>');
  show('s-end');
}

// ================================================================
//  INIT
// ================================================================
function startGame(){
  sanity=100;chIdx=0;dIdx=0;dMode='pre';
  wrongCount=0;choiceMade=null;puzzleOk=false;
  setSanity(100);
  beginChapter();
}

document.getElementById('d-next').addEventListener('click',nextDialog);
show('s-title');
</script>
